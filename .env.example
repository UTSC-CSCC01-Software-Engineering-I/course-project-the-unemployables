# Copy this file to .env and fill in values before running
PORT=3001
DATA_DIR=./CDMP-data   # path to the CDMP-data folder on the host (used outside Docker)

# Supabase — place these in client/.env (Vite reads VITE_* at build time)
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here
