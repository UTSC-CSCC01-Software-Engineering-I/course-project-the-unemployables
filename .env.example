# Single root .env — used by both server (Express) and client (Vite).
# Copy to .env and fill in real values. Never commit .env.

# Server-side and Python scripts (service role key - never exposed to the browser)
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_SERVICE_KEY=your-service-role-key-here
PORT=3001

# Client-side — Vite bundles VITE_* vars into the browser bundle (use anon key only)
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here
